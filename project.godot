; Engine configuration file for Astra.
;
; "generic" settings live here; gameplay tuning lives on the exported
; properties of the scenes and on the EnemyType resources in res://resources.
;
; https://github.com/novaprime-code/astra

config_version=5

[application]

config/name="Astra"
config/version="0.1.0"
config/description="A small arcade archery survival game built in Godot 4."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameState="*res://autoload/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; "keep" rather than "expand": the arena is a fixed playfield, so every player
; must see exactly the same amount of it regardless of window size.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
, Object(InputEventKey,"device":-1,"physical_keycode":4194319)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
, Object(InputEventKey,"device":-1,"physical_keycode":4194321)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)
]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
, Object(InputEventKey,"device":-1,"physical_keycode":4194320)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
, Object(InputEventKey,"device":-1,"physical_keycode":4194322)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)
]
}
shoot={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
, Object(InputEventJoypadButton,"device":-1,"button_index":2)
]
}
astra={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2)
, Object(InputEventKey,"device":-1,"physical_keycode":81)
, Object(InputEventJoypadButton,"device":-1,"button_index":3)
]
}
dodge={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32)
, Object(InputEventJoypadButton,"device":-1,"button_index":0)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
, Object(InputEventJoypadButton,"device":-1,"button_index":6)
]
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82)
]
}
confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194309)
, Object(InputEventKey,"device":-1,"physical_keycode":32)
, Object(InputEventJoypadButton,"device":-1,"button_index":0)
]
}

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="player_projectile"
2d_physics/layer_4="enemy_projectile"
2d_physics/layer_5="wall"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.094, 1)
