extends Node
## Headless smoke test. Run it, read the exit code.
##
##     godot --headless --path . res://tests/smoke_test.tscn
##
## This is not a unit-test framework and does not want to be one. It boots the
## real arena and asserts the handful of things that, if they broke, would mean
## the game is not playable at all: the project loads, a wave starts, the bow
## fires, enemies die and score, the player can die, and the walls hold.
##
## Everything here avoids waiting on wall-clock time. Physics frames are a
## fixed 1/60s step, so awaiting them is deterministic; the wave director's
## own pacing runs on render-frame deltas, which in a headless build are
## meaninglessly small, so spawns are driven directly instead.

const ARENA := "res://scenes/arena.tscn"

var _failures: Array[String] = []
var _checks: int = 0

var _saw_wave_started: bool = false
var _saw_wave_number: int = 0
var _saw_enemy_killed: bool = false
var _saw_player_died: bool = false
var _saw_health_change: bool = false

func _ready() -> void:
	# Sound off for the whole run. Nothing here tests audio playback, and a
	# playback still draining at exit shows up as a leaked object, which would
	# make CI fail at random.
	AudioManager.enabled = false
	await _run()

	print("")
	if _failures.is_empty():
		print("PASS  %d checks" % _checks)
		get_tree().quit(0)
	else:
		print("FAIL  %d of %d checks" % [_failures.size(), _checks])
		for failure in _failures:
			print("  - %s" % failure)
		get_tree().quit(1)

func _run() -> void:
	print("Astra smoke test")
	print("----------------")

	_test_audio()
	_test_enemy_types()
	_test_wave_building()
	_test_save_round_trip()
	await _test_scenes_load()
	await _test_arena()
	# Let every queue_free() from the tests actually run, and silence any
	# trailing sound, so the engine reports no leaks at exit.
	AudioManager.stop_all()
	await _physics(4)

# ---------------------------------------------------------------- assertions

func _check(ok: bool, what: String) -> void:
	_checks += 1
	if ok:
		print("  ok    %s" % what)
	else:
		print("  FAIL  %s" % what)
		_failures.append(what)

func _check_eq(actual: Variant, expected: Variant, what: String) -> void:
	_check(actual == expected, "%s (got %s, want %s)" % [what, actual, expected])

# ------------------------------------------------------------------ data load

func _test_enemy_types() -> void:
	print("\nenemy types")
	for path in WaveDirector.DEFAULT_ENEMY_TYPES:
		var exists := ResourceLoader.exists(path)
		_check(exists, "%s exists" % path.get_file())
		if not exists:
			continue
		var type := load(path)
		_check(type is EnemyType, "%s loads as EnemyType" % path.get_file())
		if type is EnemyType:
			_check(type.max_health > 0.0, "%s has positive health" % type.id)
			_check(type.spawn_cost > 0.0, "%s has positive spawn cost" % type.id)

# ---------------------------------------------------------------------- audio

func _test_audio() -> void:
	print("\naudio")
	# The .wav files are generated by tools/make_sounds.py. If one fails to
	# import, the game still runs but silently, which is easy to miss.
	_check_eq(AudioManager.loaded_count(), AudioManager.SOUNDS.size(), "every sound file loaded")
	# An unknown key must be a no-op, not a crash.
	AudioManager.play("no_such_sound")
	_check(true, "playing an unknown sound is harmless")
	AudioManager.stop_all()
	_check(not AudioManager.enabled, "audio stays disabled for the test run")

# --------------------------------------------------------------- wave pacing

func _test_wave_building() -> void:
	print("\nwave building")
	var director := WaveDirector.new()
	director._load_default_enemy_types()
	_check(director.enemy_types.size() >= 3, "default enemy types loaded")

	# Wave 1 must be footmen only: nothing else is unlocked yet, and a first
	# wave that opens with a charger is how a game loses a player in 10s.
	var first := director._build_wave(1)
	_check(not first.is_empty(), "wave 1 is not empty")
	var only_wave_one_types := true
	for type in first:
		if type.unlock_wave > 1:
			only_wave_one_types = false
	_check(only_wave_one_types, "wave 1 contains only wave-1 enemies")

	# Every wave up to 40 must be non-empty, within the cap, and never
	# regress far in size. A silent empty wave would soft-lock the run.
	var all_valid := true
	var all_capped := true
	for wave in range(1, 41):
		var plan := director._build_wave(wave)
		if plan.is_empty():
			all_valid = false
		if plan.size() > director.max_wave_size:
			all_capped = false
	_check(all_valid, "waves 1-40 all produce enemies")
	_check(all_capped, "waves 1-40 respect max_wave_size")

	# Later waves should be meaningfully harder than early ones.
	var early_cost := _plan_cost(director._build_wave(2))
	var late_cost := _plan_cost(director._build_wave(20))
	_check(late_cost > early_cost * 2.0, "wave 20 is much costlier than wave 2")

	# An exhausted budget must terminate rather than spin.
	_check(director._weighted_pick(director.enemy_types, 0.1) == null, "no pick fits a tiny budget")

	director.free()

func _plan_cost(plan: Array[EnemyType]) -> float:
	var total := 0.0
	for type in plan:
		total += type.spawn_cost
	return total

# ----------------------------------------------------------------- save files

func _test_save_round_trip() -> void:
	print("\nsave file")
	var best_before := SaveManager.best_score
	var runs_before := SaveManager.runs_played

	var is_record := SaveManager.record_run(best_before + 500, 7)
	_check(is_record, "a higher score is reported as a record")
	_check_eq(SaveManager.best_score, best_before + 500, "best score updated")
	_check_eq(SaveManager.runs_played, runs_before + 1, "run counter incremented")

	SaveManager.load_progress()
	_check_eq(SaveManager.best_score, best_before + 500, "best score survived a reload")

	_check(not SaveManager.record_run(1, 0), "a lower score is not a record")

	SaveManager.reset_progress()
	_check_eq(SaveManager.best_score, 0, "reset clears the profile")

# ------------------------------------------------------------ scene integrity

## Every scene must load and instantiate. A broken node path or a renamed
## child shows up here instead of as a crash the first time a menu opens.
func _test_scenes_load() -> void:
	print("\nscenes")
	var paths := [
		"res://scenes/main.tscn",
		"res://scenes/arena.tscn",
		"res://scenes/player.tscn",
		"res://scenes/enemy.tscn",
		"res://scenes/arrow.tscn",
		"res://scenes/enemy_arrow.tscn",
		"res://scenes/spark.tscn",
		"res://scenes/ui/hud.tscn",
		"res://scenes/ui/main_menu.tscn",
		"res://scenes/ui/pause_menu.tscn",
		"res://scenes/ui/game_over.tscn",
	]
	for path: String in paths:
		var scene: PackedScene = load(path) if ResourceLoader.exists(path) else null
		if scene == null:
			_check(false, "%s loads" % path.get_file())
			continue
		var instance := scene.instantiate()
		_check(instance != null, "%s instantiates" % path.get_file())
		if instance == null:
			continue
		# Adding it to the tree is what actually exercises _ready, @onready
		# node paths and signal connections.
		add_child(instance)
		await _physics(1)
		if is_instance_valid(instance):
			_check(instance.is_inside_tree(), "%s enters the tree" % path.get_file())
			instance.queue_free()
			await _physics(1)
		else:
			# Some scenes are fire-and-forget. A spark that was never given a
			# burst has nothing to draw and correctly removes itself on its
			# first frame, so vanishing is a pass, not a failure.
			_check(true, "%s self-freed on its first frame" % path.get_file())

	# main.tscn must boot to the menu rather than straight into a run.
	# Checked here rather than inside the loop, because loading arena.tscn
	# above legitimately does start one.
	var main_scene: PackedScene = load("res://scenes/main.tscn")
	var main_instance := main_scene.instantiate()
	add_child(main_instance)
	await _physics(1)
	_check(not GameState.is_running, "main.tscn boots to the menu, not a run")
	main_instance.queue_free()
	await _physics(1)

# ------------------------------------------------------------- live integration

func _test_arena() -> void:
	print("\narena boot")

	EventBus.wave_started.connect(_on_wave_started)
	EventBus.enemy_killed.connect(_on_enemy_killed)
	EventBus.player_died.connect(_on_player_died)
	EventBus.player_health_changed.connect(_on_health_changed)

	var scene: PackedScene = load(ARENA)
	_check(scene != null, "arena.tscn loads")
	if scene == null:
		return

	var arena: Arena = scene.instantiate()
	add_child(arena)
	await _physics(2)

	_check(arena.player() != null, "player exists in the arena")
	_check(arena.director() != null, "wave director exists")
	_check(arena.bounds().size.x > 100.0, "arena has a sane width")
	_check(_saw_wave_started, "wave_started fired on boot")
	_check_eq(_saw_wave_number, 1, "first wave is wave 1")
	_check(_saw_health_change, "player announced its starting health")

	var player := arena.player()
	_check_eq(player.health, player.max_health, "player starts at full health")
	_check(arena.bounds().has_point(player.global_position), "player starts inside the arena")

	# From here the test must own the arena. Wave 1 is already spawning, and
	# a footman wandering into the player mid-assertion is exactly the kind of
	# race that makes a suite untrustworthy. Spawning on a schedule is covered
	# by the wave-building tests and by wave_started above; everything below
	# wants an empty arena.
	await _quiesce(arena)

	await _test_bow(arena, player)
	await _test_movement(arena, player)
	await _test_enemy_damage(arena)
	await _test_player_death(player)

	arena.queue_free()
	await _physics(3)

## Stops the wave director and clears the arena, so the remaining tests run
## against a stage nothing else is writing to.
func _quiesce(arena: Arena) -> void:
	arena.director().stop()
	for enemy in get_tree().get_nodes_in_group(&"enemies"):
		enemy.queue_free()
	await _physics(2)
	_check_eq(get_tree().get_nodes_in_group(&"enemies").size(), 0, "arena can be emptied for testing")

func _test_bow(arena: Arena, player: Player) -> void:
	print("\nbow")
	var before := _count_arrows(arena)

	Input.action_press("shoot")
	# charge_time is in seconds of physics time; +4 frames of headroom.
	await _physics(int(player.charge_time * 60.0) + 4)
	_check(player.charge_ratio() >= 0.99, "bow reaches full charge")
	_check(is_zero_approx(player.astra_ratio() - 1.0), "astra starts available")

	Input.action_release("shoot")
	await _physics(3)
	_check_eq(player.charge_ratio(), 0.0, "charge resets after release")
	_check(_count_arrows(arena) > before, "releasing the bow spawns an arrow")

	# Astra should fire a full volley and then go on cooldown.
	var before_astra := _count_arrows(arena)
	Input.action_press("astra")
	await _physics(2)
	Input.action_release("astra")
	await _physics(2)
	_check(_count_arrows(arena) >= before_astra + player.astra_arrows, "astra fires a full volley")
	_check(player.astra_ratio() < 1.0, "astra goes on cooldown after firing")

func _test_movement(arena: Arena, player: Player) -> void:
	print("\nmovement and walls")
	var bounds := arena.bounds()
	player.global_position = bounds.get_center()
	player.velocity = Vector2.ZERO
	var start_x := player.global_position.x

	Input.action_press("move_right")
	await _physics(20)
	_check(player.global_position.x > start_x + 5.0, "player moves right on input")

	# Start close to the wall and keep pushing: the wall must stop it.
	player.global_position = Vector2(bounds.end.x - 70.0, bounds.get_center().y)
	await _physics(60)
	Input.action_release("move_right")
	await _physics(2)
	_check(
		player.global_position.x <= bounds.end.x + 1.0,
		"wall contains the player (x=%.1f, wall=%.1f)" % [player.global_position.x, bounds.end.x]
	)

func _test_enemy_damage(arena: Arena) -> void:
	print("\nenemies")
	var footman: EnemyType = load(WaveDirector.DEFAULT_ENEMY_TYPES[0])
	var spawn_at := arena.bounds().get_center() + Vector2(220.0, 0.0)
	var enemy: Node = arena.director().spawn_enemy(footman, spawn_at)
	_check(enemy != null, "director spawns an enemy on demand")
	if enemy == null:
		return

	await _physics(2)
	_check(enemy.is_in_group(&"enemies"), "spawned enemy joins the enemies group")
	_check_eq(enemy.health, footman.max_health, "enemy starts at full health")

	# A partial hit must wound without killing.
	enemy.take_damage(1.0, Vector2.RIGHT)
	await _physics(1)
	_check(enemy.health < footman.max_health, "enemy takes damage")
	_check(is_instance_valid(enemy), "a partial hit does not kill")

	var score_before := GameState.score
	enemy.take_damage(999.0, Vector2.RIGHT)
	await _physics(2)
	_check(_saw_enemy_killed, "enemy_killed fired on death")
	_check(not is_instance_valid(enemy), "dead enemy is freed")
	_check(GameState.score > score_before, "killing an enemy scores points")
	_check(GameState.combo > 1.0, "killing an enemy raises the combo")

func _test_player_death(player: Player) -> void:
	print("\nplayer death")
	# Remove the invulnerability window so the run can be ended in a few
	# frames rather than several real seconds. Any window already counting
	# down has to be waited out first: the field is private, and poking at it
	# would be testing the implementation rather than the behaviour.
	player.invulnerable_time = 0.0
	var waited := 0
	while player.is_invulnerable() and waited < 120:
		waited += 1
		await _physics(1)
	_check(not player.is_invulnerable(), "invulnerability expires")

	var guard := 0
	while player.health > 0 and guard < 60:
		guard += 1
		player.take_damage(1)
		await _physics(1)

	_check_eq(player.health, 0, "player health reaches zero")
	_check(not player.is_alive, "player is no longer alive")
	_check(_saw_player_died, "player_died fired")
	_check(not player.take_damage(1), "a dead player cannot be damaged again")

# --------------------------------------------------------------------- helpers

func _physics(count: int) -> void:
	for _i in maxi(1, count):
		await get_tree().physics_frame

func _count_arrows(arena: Arena) -> int:
	var total := 0
	for child in arena.entities().get_children():
		if child is Arrow:
			total += 1
	return total

func _on_wave_started(number: int, _size: int) -> void:
	if not _saw_wave_started:
		_saw_wave_number = number
	_saw_wave_started = true

func _on_enemy_killed(_at: Vector2, _points: int, _colour: Color) -> void:
	_saw_enemy_killed = true

func _on_player_died(_score: int) -> void:
	_saw_player_died = true

func _on_health_changed(_current: int, _maximum: int) -> void:
	_saw_health_change = true
