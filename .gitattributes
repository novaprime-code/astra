# Normalise line endings so diffs stay readable across Linux and Windows.
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.py      text eol=lf

*.png     binary
*.wav     binary
*.ogg     binary
